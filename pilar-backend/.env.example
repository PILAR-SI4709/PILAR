# Contoh konfigurasi environment PILAR backend.
# Salin ke `.env` lalu isi nilai yang sebenarnya. JANGAN commit kredensial asli.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT
JWT_SECRET="ganti_dengan_secret_acak"

# TASK 7 - SMTP untuk notifikasi email.
# Kosongkan untuk menonaktifkan pengiriman email (sistem tetap berjalan normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun@gmail.com
SMTP_PASS=app_password_16_karakter
SMTP_FROM=PILAR <no-reply@pilar.id>
